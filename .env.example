NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional admin area. Use the email address of your existing Supabase account.
# Never prefix the service-role key with NEXT_PUBLIC_.
ADMIN_EMAILS=your-admin-email@example.com
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: enable Flipkart's official product lookup when registered affiliate credentials are available.
# Keep these server-only values private. Never prefix them with NEXT_PUBLIC_.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
